{
  "name": "sidecast",
  "version": "0.3.0",
  "description": "Your chat. In the game. Streamer.bot desktop overlays and OBS sources.",
  "author": "Sidecast",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/smoke.mjs",
    "test:performance": "node scripts/performance.mjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:signed": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dist-signed.ps1",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "app.sidecast.desktop",
    "productName": "Sidecast",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "tts/**/*",
      "!tts/**/__pycache__/**",
      "scripts/setup-tts.ps1",
      "package.json",
      "scripts/setup-chatterbox.ps1"
    ],
    "asarUnpack": [
      "src/tts-windows.ps1",
      "tts/**/*",
      "scripts/setup-tts.ps1",
      "scripts/setup-chatterbox.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "publisherName": "Open Source Developer Daniel Sosulski"
      }
    },
    "portable": {
      "artifactName": "Sidecast-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Sidecast-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "publish": {
      "provider": "github",
      "owner": "DSuzuki35",
      "repo": "Sidecast",
      "releaseType": "release"
    }
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  },
  "dependencies": {
    "@streamerbot/client": "^2.0.2",
    "electron-updater": "6.8.11",
    "qrcode": "1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.1"
  }
}
